# Anthropic API key for LLM agents (Haiku-4.5 for agents, Sonnet-4.6 for judge)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# FRED API key for macroeconomic data (free at https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your_fred_api_key_here

# LLM cache mode: "read-write" for new runs, "read-only" for reproducing paper results
LLM_CACHE_MODE=read-write

# Hard budget cap in USD — batch runner aborts if cumulative API spend exceeds this
MAX_API_BUDGET_USD=100

# Number of simulations per condition (25 for full runs, 2 for smoke tests)
SIMS_PER_CONDITION=25

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
